# Copy this file to .env and fill in the required values. `expo start` loads .env
# automatically. For EAS builds, mirror these into EAS environment variables
# (see README — the values never live in eas.json or git).

# --- Google Maps (native, baked in at build time) -------------------------
# Two SEPARATE keys from the same GCP project, both restricted (README: Google Maps API keys):
#   Android key: restricted to package com.yycskatespots.app + SHA-1
#   iOS key:     restricted to bundle id com.yycskatespots.app
GOOGLE_MAPS_API_KEY_ANDROID=
GOOGLE_MAPS_API_KEY_IOS=

# --- Convex (EXPO_PUBLIC_* = embedded in the client JS bundle) ------------
# Printed by `npx convex dev` on first run.
EXPO_PUBLIC_CONVEX_URL=
# HTTP actions host (photo uploads). Optional for default deployments, where it
# is derived as <deployment>.convex.site; required when using a custom domain.
EXPO_PUBLIC_CONVEX_SITE_URL=

# --- Clerk -----------------------------------------------------------------
# Clerk Dashboard → API Keys → Publishable key (pk_test_... / pk_live_...)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- Share links -----------------------------------------------------------
# Public HTTPS origin that hosts /privacy, /support, /standards, /share, and
# /.well-known/apple-app-site-association.
# Use only the origin, with no path, query, fragment, credentials, or port.
EXPO_PUBLIC_SHARE_BASE_URL=
